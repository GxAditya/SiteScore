# ─────────────────────────────────────────────────────────────────────────────
# SiteScore environment contract
# Copy to .env.local (gitignored) or set in your host's dashboard.
# NEVER commit a filled-in copy of this file.
#
# Rule of thumb: if a secret appears in git, treat it as compromised and
# rotate it at the provider immediately. Rotation is the only real fix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider keys (server-side only, never exposed to the browser) ──────────
# TinyFish Search + Fetch. Get one free at https://agent.tinyfish.ai/api-keys
#
# SECURITY: in production this key is NOT used for anonymous traffic unless
# ALLOW_PLATFORM_KEY=true. Default behaviour is hard BYOK: every call is billed
# to the caller's own key, or refused. Set the key and leave the default and it
# simply sits unused, costing nothing.
TINYFISH_API_KEY=

# Google Gemini, optional, only for the AI executive summary.
# Same rule: not used for anonymous traffic in production by default. A caller
# who supplies a BYOK key but no LLM key will NOT fall through to this one.
GEMINI_API_KEY=


# ── Cost controls (all optional; defaults are the strict/production values) ──

# Allow requests WITHOUT a BYOK key to be served with the server's key.
#   unset / false -> DENIED in production (recommended: nobody can bill you)
#   true          -> anonymous traffic spends YOUR key, but is still rate
#                    limited and capped by the budgets below.
# Default: true only when NODE_ENV !== "production".
ALLOW_PLATFORM_KEY=

# Rate limits PER IDENTITY (BYOK key fingerprint, else client IP).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=120
RATE_LIMIT_PER_DAY=500

# Platform-wide ceilings. These are your actual bill protection: they apply
# across ALL users, including every distinct BYOK key, and across all server
# instances when the Redis backend below is configured.
RATE_LIMIT_GLOBAL_PER_HOUR=3000
RATE_LIMIT_GLOBAL_PER_DAY=20000

# Concurrency: caps simultaneous in-flight audits. Without this, a bot can
# open hundreds of parallel requests and each one costs upstream calls.
RATE_LIMIT_MAX_CONCURRENT=10
RATE_LIMIT_MAX_CONCURRENT_PER_IDENTITY=2

# Hard daily ceiling on LLM calls billed to the platform key.
# Set to 0 to disable the AI summary entirely for platform-key traffic.
LLM_PLATFORM_KEY_PER_DAY=50

# LLM generation budget. Server-owned; client requests are clamped to these.
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_PROMPT_CHARS=12000
MAX_AUDIT_DURATION_MS=100000

# When a configured rate-limit backend is unreachable, deny (true, fail-closed
# and recommended) or allow (false, risky: turns a backend outage into an
# unlimited-spend window).
RATELIMIT_FAIL_CLOSED=true


# ── Optional: shared access token ───────────────────────────────────────────
# When set, /api/audit REQUIRES `x-sitescore-token: <value>`.
# The cheapest way to make a public deployment non-public.
SITESCORE_ACCESS_TOKEN=


# ── Optional: distributed rate limiting (recommended in production) ─────────
# Without these, rate limits are PER SERVER INSTANCE. On Vercel that means an
# attacker gets a fresh allowance on every cold start, which substantially
# weakens the limits. Any Upstash / Redis-REST compatible service works.
# With these set and unreachable, SiteScore FAILS CLOSED (denies requests).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Optional: encryption at rest for any stored provider keys ──────────────
# Format: comma-separated `<kid>:<base64-32-byte-key>`. The FIRST entry is the
# active (write) key; older entries remain readable until removed.
# Generate one with:
#   node -e "console.log('k'+Date.now()+':'+require('crypto').randomBytes(32).toString('base64'))"
#
# Rotation:  add a new key as the FIRST entry, keep the old one after it.
#            New writes use the new key; old data still decrypts.
# Revocation: delete a `kid` entirely. Everything sealed under it becomes
#            permanently unreadable - this is the kill switch.
# When unset, the encrypted store refuses to persist anything (fail closed).
KEY_ENCRYPTION_KEYRING=
# Deployment-wide scrypt salt. Set this too; changing it makes existing
# ciphertext unreadable, so set it once and leave it alone.
KEY_ENCRYPTION_SALT=

# Optional HMAC pepper for key fingerprints used in logs/limits.
# Rotating it changes fingerprints (existing in-memory limits reset; no data
# loss). Set the same value on every instance, or fingerprints diverge.
KEY_FINGERPRINT_PEPPER=

# Salt for IP hashing. Same requirement: identical across all instances.
INSTANCE_SALT=


# ── Optional: infrastructure / logging ─────────────────────────────────────
# Only trust the given request header for client IP when a proxy in front of
# the app sets it. Leave unset unless you actually sit behind such a proxy -
# a spoofable header would let an attacker bypass per-IP limits.
TRUSTED_PROXY_HEADER=

# Emit structured JSON audit events to stdout (hash-chained, no secrets).
AUDIT_LOG_ENABLED=true

# Usage-spike anomaly detection.
ANOMALY_SPIKE_FACTOR=3
ANOMALY_ABSOLUTE_THRESHOLD=2000

# In non-production only, whether upstream error text may reach the client.
# Always false in production: responses use a fixed allow-list of messages.
REDACT_UPSTREAM_ERRORS=true